{
  "ignorePatterns": ["**2/**/*.ts", "**/*2.ts", "IsoGameAddon/**/*"],
  "rules": {
    "unused-files": "off",
    "unused-exports": "off",
    "unused-types": "off",
    "circular-dependencies": "off",
    "private-type-leaks": "off",
    "unresolved-imports": "off"
  },
   "duplicates": {
    "mode": "mild",
    "minTokens": 280,
    "minLines": 1128,
    "threshold": 10
  },
  "health": {
    "maxCyclomatic": 200,
    "maxCognitive": 150,
    "ignore": ["**/*.generated.ts"]
  }
}
